# ---------- Aplikasi ----------
NODE_ENV=development
PORT=4000
# Origin frontend yang boleh mengakses API. Pisahkan dengan koma jika lebih dari satu.
CORS_ORIGIN=http://localhost:5173

# ---------- Database (MariaDB) ----------
# Harus sama dengan .env di root (dipakai docker-compose).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pooltrack
DB_PASSWORD=pooltrack_secret
DB_NAME=pooltrack
# Zona waktu sesi database (offset). +07:00 = WIB
DB_TIMEZONE=+07:00

# ---------- Auth (login) ----------
# Kunci rahasia token login: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Masa berlaku token login, mis. 8h (8 jam) atau 1d (1 hari)
JWT_EXPIRES_IN=8h
